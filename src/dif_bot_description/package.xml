<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dif_bot_description</name>
  <version>0.0.1</version>
  <description>
    Actividades 4 a 8 y Mini-Proyecto de la guia RO2 Part3: descripcion
    URDF/Xacro de un robot diferencial (dif_bot) con propiedades fisicas,
    sensores (IMU, Lidar, Camara), visualizacion en RViz e integracion
    con Gazebo Ignition / GZ Sim (Harmonic) sobre ROS 2 Jazzy.
  </description>
  <maintainer email="student@example.com">Estudiante</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
