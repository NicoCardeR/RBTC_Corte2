<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Actividad 8: Integracion con Gazebo Ignition (GZ Sim / Harmonic)

    IMPORTANTE: la sintaxis del plugin de traccion diferencial cambio
    respecto a Gazebo clasico (usado en la guia base, que usaba
    "libgazebo_ros_diff_drive.so"). En GZ Sim (Harmonic, el que trae
    ROS 2 Jazzy sobre Ubuntu 24.04) el plugin es un "system plugin"
    nativo de Gazebo (gz-sim-diff-drive-system) que publica/escucha
    directamente en topicos de gz-transport. Esos topicos se conectan
    a ROS 2 mediante ros_gz_bridge (ver config/gz_bridge.yaml y
    launch/gz_sim_launch.py).
  -->
  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
      <!-- ruedas -->
      <left_joint>drivewhl_l_joint</left_joint>
      <right_joint>drivewhl_r_joint</right_joint>

      <!-- cinematica -->
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <!-- limites -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <!-- topicos (dentro del namespace del modelo) -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>

      <!-- salida -->
      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <!-- Publica el estado de las articulaciones (ruedas) para que
         robot_state_publisher pueda completar el TF tree en simulacion -->
    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>drivewhl_l_joint</joint_name>
      <joint_name>drivewhl_r_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
