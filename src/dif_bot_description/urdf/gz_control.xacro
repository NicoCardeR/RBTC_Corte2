<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Plugin DiffDrive de GZ Sim. Los topicos se conectan a ROS 2
       con ros_gz_bridge (config/gz_bridge.yaml). -->
  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
      <left_joint>drivewhl_l_joint</left_joint>
      <right_joint>drivewhl_r_joint</right_joint>

      <!-- geometrico 0.36; calibrado a 0.322 (guia 2.8) -->
      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <xacro:if value="$(arg use_ekf)"><tf_topic>tf_plugin_sin_usar</tf_topic></xacro:if>
      <xacro:unless value="$(arg use_ekf)"><tf_topic>tf</tf_topic></xacro:unless>

      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_odom>true</publish_odom>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>drivewhl_l_joint</joint_name>
      <joint_name>drivewhl_r_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
