<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtle_launch_demos</name>
  <version>0.0.1</version>
  <description>
    Actividades 1 y 2 de la guia RO2 Part3: archivos launch basicos, namespaces,
    remapeos, lanzamiento jerarquico, argumentos y eventos usando turtlesim.
  </description>
  <maintainer email="student@example.com">Estudiante</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>turtlesim</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
